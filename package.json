{
  "name": "lebenswerter-guertel",
  "version": "1.8.5",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "run-p type-check \"build-only {@}\" --",
    "preview": "vite preview",
    "test:unit": "vitest",
    "prepare": "cypress install && git config core.hooksPath .githooks",
    "test:e2e": "start-server-and-test preview http://localhost:4173 'cypress run --e2e'",
    "test:e2e:dev": "start-server-and-test 'vite dev --port 4173' http://localhost:4173 'cypress open --e2e'",
    "build-only": "vite build",
    "type-check": "vue-tsc --build",
    "lint": "eslint . --fix --cache",
    "format": "prettier --write --experimental-cli src/"
  },
  "dependencies": {
    "@tailwindcss/vite": "4.3.5",
    "@unhead/vue": "3.4.3",
    "pinia": "4.1.0",
    "tailwindcss": "4.3.5",
    "vue": "3.5.45",
    "vue-router": "5.5.0"
  },
  "devDependencies": {
    "@tsconfig/node24": "24.0.6",
    "@types/jsdom": "30.0.0",
    "@types/node": "26.6.6",
    "@vitejs/plugin-vue": "6.0.11",
    "@vitejs/plugin-vue-jsx": "5.1.6",
    "@vitest/eslint-plugin": "1.6.27",
    "@vue/eslint-config-typescript": "14.9.0",
    "@vue/test-utils": "2.5.1",
    "@vue/tsconfig": "0.9.1",
    "cypress": "16.3.0",
    "eslint": "10.14.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-cypress": "7.0.4",
    "eslint-plugin-vue": "10.12.1",
    "jiti": "2.7.0",
    "jsdom": "31.0.0",
    "npm-run-all2": "9.0.4",
    "prettier": "3.10.1",
    "start-server-and-test": "3.0.13",
    "typescript": "6.0.3",
    "vite": "8.3.8",
    "vite-plugin-vue-devtools": "8.2.1",
    "vitest": "5.1.0",
    "vue-tsc": "3.3.14"
  },
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  }
}
